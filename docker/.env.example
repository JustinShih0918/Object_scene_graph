# Copy to docker/.env and fill in. Relative paths resolve from docker/compose.yaml.
#
#   cp docker/.env.example docker/.env
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> docker/.env
#
# Every variable compose.yaml reads is listed here. Only UID/GID and
# HM3D_SCENES normally need changing when the two repositories are siblings.

COMPOSE_PROJECT_NAME=object_scene_graph
COMPOSE_FILE=compose.yaml

# --- container user (REQUIRED) ----------------------------------------------
# The image builds a non-root user with these ids, and /workspace is a bind
# mount of this checkout. If they do not match the checkout's owner, the
# container cannot write outputs/ or data/ and every run fails on permissions.
#
# These MUST be set here. `UID` is a shell built-in that bash does not export,
# so compose never sees it from your environment -- it silently falls back to
# 1000, which is wrong on any machine where you are not the first user.
#   id -u    ->  UID
#   id -g    ->  GID
UID=1000
GID=1000

# --- HM3D scenes (REQUIRED for HM3D evaluation) -----------------------------
# The scene meshes are license-gated and far too large for the repo, so they
# live outside it and are mounted onto data/versioned_data, which
# data/scene_datasets/hm3d symlinks into. Point this at the directory that
# CONTAINS hm3d-0.2/ (i.e. the parent of the versioned scene tree).
#
# Wrong or unset, the eval does not fail with a missing file: it dies inside
# the env worker with "No Stage Attributes exists for requested scene
# ...basis.glb". Default assumes the scenes are already at ../data/versioned_data.
HM3D_SCENES=../data/versioned_data

# --- habitat-data-collector -------------------------------------------------
# Mount the complete checkout read-write so its application, configs, data,
# and outputs are usable from the nav container. Relative paths are resolved
# from docker/compose.yaml. The container runs with UID/GID above, so files it
# creates here keep the same ownership as files created on the host.
HABITAT_COLLECTOR_DIR=../../habitat-data-collector

# --- optional ---------------------------------------------------------------
# Only for `verification=nim` (the hosted VLM verifier), which is OFF in the
# default arm. Leave blank otherwise; compose warns about the empty value and
# carries on.
NVIDIA_API_KEY=

# Inherited from your shell if unset. Empty is fine and headless work is
# unaffected -- GUI tools then fail with "Failed to open connection to X
# server". Note compose also bind-mounts $HOME/.Xauthority; if that file does
# not exist on the host, docker creates a DIRECTORY there and X clients fail
# oddly, so `touch ~/.Xauthority` first if you want the GUI viewer.
#
# The Thor's `rviz` service defaults DISPLAY to :1 (its GNOME session) and
# reads the GDM cookie at /run/user/<UID>/gdm/Xauthority; set XAUTHORITY here
# to point it elsewhere. `ls /tmp/.X11-unix` shows which display is live.
DISPLAY=

# --- Jetson AGX Thor (docker/compose.thor.yaml, docs/THOR.md) ---------------
# Only read by the Thor deployment. Every one of these can ONLY be settled on
# the device -- see the table in docs/THOR.md.
# The container image matching the device's JetPack: `cat /etc/nv_tegra_release`.
# NOT an l4t-* tag on JetPack 7 -- that line stops at r36.4.0 (JetPack 6 /
# Orin) and the r38/r39 tags do not exist. JetPack 7 runs the ordinary arm64
# NGC images, and this one carries CUDA 13, nvcc and a torch built for sm_110.
BASE_IMAGE=nvcr.io/nvidia/pytorch:25.10-py3
# TORCH_CUDA_ARCH_LIST for the compiled kernels. Thor is Blackwell-generation,
# Orin is 8.7. Wrong value -> GroundingDINO falls back to CPU.
CUDA_ARCH=11.0
# NVIDIA's Jetson wheel index, for a JetPack-6 base whose image has no torch.
# EMPTY on JetPack 7: torch is in the base image, and the jp7 index that used
# to be named here has been withdrawn (410 Gone).
TORCH_INDEX_URL=
# 0 to skip salesforce-lavis; then run with exploration.value_model=clip.
WITH_BLIP2=1

# --- ROS 2 / Stretch 3 (docker/compose.ros2.yaml, docs/ROS2.md) -------------
# Only read when the ros2 override is applied. Must match the robot's domain;
# anything sharing a domain shares topics, so a shared lab wants its own.
ROS_DOMAIN_ID=0
# The Stretch runs CycloneDDS. Mismatched vendors discover each other badly.
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# --- CycloneDDS, on the wired link to the robot ------------------------------
# The tuning is NOT this repo's. `stretch_main` drives the same Stretch and
# owns the settings; docker/cyclonedds-eth.xml is a copy of its file, and the
# header there says so. KEEP THE TWO IN SYNC: the config pins DDS to the wired
# NIC at both ends, and it only works if both ends pin the SAME way -- a
# machine left on Cyclone's autodetermine may choose its Wi-Fi NIC, and then
# the two never discover each other. Drift between the copies reproduces
# exactly that, and silently. To check:
#   diff docker/cyclonedds-eth.xml ../stretch_main/docker/cyclonedds-eth.xml
#
# Repoint this to use a different file. If it names nothing, docker creates a
# DIRECTORY at the mount point and Cyclone fails loudly with "can't open
# configuration file". Relative paths resolve from docker/.
CYCLONEDDS_CONFIG=./cyclonedds-eth.xml
# Where that file is mounted INSIDE every container. stretch_main uses this
# same absolute path, so one exported CYCLONEDDS_URI stays valid across all of
# them even though each mounts its workspace somewhere different. Set it to
# empty to let Cyclone use its own defaults (autodetermine, no peer list).
CYCLONEDDS_URI=/etc/cyclonedds-eth.xml
# THIS machine's wired NIC -- not the robot's. `ip -brief addr` to find it.
# The Thor's is enP2p1s0. A name that does not exist, or an interface that is
# down, is not silent: Cyclone refuses to start and says so.
CYCLONEDDS_IFACE=enP2p1s0
#
# One host prerequisite, because network_mode: host means the HOST's value is
# what applies: the stock 208 kB socket buffer is smaller than a single camera
# frame, which shows up as stuttering or vanishing images rather than an
# error. Already set on this Thor; on a new machine:
#   echo 'net.core.rmem_max=134217728' | sudo tee /etc/sysctl.d/60-cyclonedds.conf
#   sudo sysctl --system
